{
  "name": "dorganizer",
  "version": "1.0.0",
  "description": "A local CLI utility that monitors your downloads folder and automatically organizes files into subfolders based on extension",
  "main": "dist/index.js",
  "bin": {
    "dorganizer": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2"
  }
}